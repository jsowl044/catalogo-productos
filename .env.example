# Copia este archivo a ".env" y ajusta los valores. El archivo ".env" NO se sube a git.

# Puerto del servidor (por defecto 3000)
PORT=3000

# Opcional. Conexión a MongoDB (local o Atlas). Si no la defines, se omite MongoDB.
# Nunca escribas aquí una contraseña real en este archivo de ejemplo.
# MONGO_URI=mongodb://localhost:27017/product-catalog

# Opcional. Ruta del archivo SQLite (por defecto db/products.db)
# SQLITE_DB_PATH=./data/catalogo.db
